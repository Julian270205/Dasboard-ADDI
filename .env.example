# Copia este archivo a infra/.env (local) o a /opt/addi-dashboard/.env (EC2).
# NUNCA subas el .env real al repositorio.
# Genera secretos con:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Imágenes (las publica GitHub Actions; EN MINÚSCULAS) ---
REGISTRY=ghcr.io/julian270205/dasboard-addi
TAG=latest

# --- Dominio ---
# Local: :80     Producción: tu-subdominio.duckdns.org
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost

# --- PostgreSQL (un solo servidor, dos bases) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=cambia-esto
APP_DB=addi
APP_DB_USER=addi_api
APP_DB_PASSWORD=cambia-esto
N8N_DB=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=cambia-esto

# --- API ---
# local en tu PC; produccion en la EC2 (cookies seguras y secretos obligatorios)
ENV=local
JWT_SECRET=cambia-esto
SESSION_HOURS=8
# Token compartido entre la API y n8n (cabecera X-Internal-Token)
API_INTERNAL_TOKEN=cambia-esto
# Cortes sin respuesta antes de que decida el suplente (Propuesta COBIT)
CORTES_PARA_ESCALAR=2
# Solo si el frontend corre en otro origen durante el desarrollo
CORS_ORIGINS=

# --- n8n ---
N8N_VERSION=latest
N8N_ENCRYPTION_KEY=cambia-esto
CORREO_REMITENTE=tablero@addi.demo
